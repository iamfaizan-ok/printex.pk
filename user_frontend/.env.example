# PrintX Customer Frontend Environment Configuration
# NOTE: Only variables prefixed with VITE_ are exposed to the client.
# NEVER place secret API keys or private credentials here.

# Optional Django Backend API Base URL (empty for local frontend-only mode)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Maximum file upload size in bytes (e.g., 50MB = 52428800)
VITE_MAX_FILE_SIZE_BYTES=52428800

# Maximum number of files per order draft
VITE_MAX_FILES_COUNT=10
