# ==============================================================================
# PrintX User Frontend — Environment Variables Example
# Set these in your Vercel Project Settings > Environment Variables
# ==============================================================================

# Replace with your deployed Render backend URL (include /api/v1)
VITE_API_BASE_URL=https://printx-backend.onrender.com/api/v1

# Maximum allowable file upload size per document (default: 50MB)
VITE_MAX_FILE_SIZE_BYTES=52428800

# Maximum number of files allowed per order submission (default: 10)
VITE_MAX_FILES_COUNT=10
